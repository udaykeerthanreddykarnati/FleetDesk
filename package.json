{
  "name": "fleet-logistics-management",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:seed": "node --env-file=.env.local --conditions=react-server --import tsx backend/scripts/seed.ts",
    "db:sync-vectors": "node --env-file=.env.local --conditions=react-server --import tsx backend/scripts/sync-vectors.ts",
    "db:mysql": "mysql -h 127.0.0.1 -P 3307 -u root fleet_logistics",
    "db:psql": "psql -h 127.0.0.1 -p 5433 -U postgres -d fleet_vectors",
    "admin:create": "node --env-file=.env.local --conditions=react-server --import tsx backend/scripts/create-admin.ts",
    "test:integration": "node --env-file=.env.local --conditions=react-server ./node_modules/vitest/vitest.mjs run --config vitest.integration.config.mts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.400.0",
    "mysql2": "^3.24.6",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5"
  }
}
