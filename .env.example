# MySQL is the source of truth for operational records.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=fleet_app
MYSQL_PASSWORD=replace-with-a-local-password
MYSQL_DATABASE=fleet_logistics

# PostgreSQL is used only for pgvector incident similarity search.
PG_VECTOR_URL=postgresql://fleet_app:replace-with-a-local-password@127.0.0.1:5433/fleet_vectors

# Random key for server-side sessions. Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-characters

# Local Ollama embedding service and model.
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=nomic-embed-text
